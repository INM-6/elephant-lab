{
  "name": "jupyphant",
  "version": "0.1.0",
  "description": "Visualization",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension"
  ],
  "homepage": "https://github.com/my_name/myextension",
  "bugs": {
    "url": "https://github.com/my_name/myextension/issues"
  },
  "license": "BSD-3-Clause",
  "author": "Bjoern Mueller",
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf, py}",
    "style/**/*.{css,eot,gif,html,jpg,json,png,svg,woff2,ttf}",
    "style/widgets.css"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/my_name/myextension.git"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "prepare": "npm run clean && npm run build",
    "watch": "tsc -w"
  },
  "dependencies": {
    "@jupyter-widgets/base": "^2.0.1",
    "@jupyter-widgets/controls": "^1.5.2",
    "@jupyter-widgets/html-manager": "^0.18.3",
    "@jupyterlab/application": "^1.1.2",
    "@jupyterlab/apputils": "^1.1.2",
    "@jupyterlab/console": "^1.1.2",
    "@jupyterlab/notebook": "^1.1.2",
    "@jupyterlab/services": "^4.1.1",
    "@phosphor/coreutils": "^1.3.1",
    "@phosphor/widgets": "^1.9.2",
    "@types/codemirror": "^0.0.77",
    "@types/d3": "^5.7.2"
  },
  "devDependencies": {
    "rimraf": "^2.6.1",
    "typescript": "~3.1.1"
  },
  "jupyterlab": {
    "extension": true
  }
}

{
  "name": "jupyphant",
  "version": "0.1.0",
  "description": "A JupyterLab extension for interactive exploration, analysis and visualization of electrophysiological data.",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension"
  ],
  "homepage": "https://github.com/INM-6/jupyphant",
  "bugs": {
    "url": "https://github.com/INM-6/jupyphant/issues"
  },
  "license": "BSD-3-Clause",
  "author": {
    "name": "Maximilian Kramer",
    "email": "m.kramer@fz-juelich.de"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "repository": {
    "type": "git",
    "url": "https://github.com/INM-6/jupyphant.git"
  },
  "scripts": {
    "build": "jlpm build:lib && jlpm build:labextension:dev",
    "build:prod": "jlpm clean && jlpm build:lib && jlpm build:labextension",
    "build:labextension": "jupyter labextension build .",
    "build:labextension:dev": "jupyter labextension build --development True .",
    "build:lib": "tsc",
    "clean": "jlpm clean:lib",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "clean:lintcache": "rimraf .eslintcache .stylelintcache",
    "clean:labextension": "rimraf jupyphant/labextension",
    "clean:all": "jlpm clean:lib && jlpm clean:labextension && jlpm clean:lintcache",
    "eslint": "jlpm eslint:check --fix",
    "eslint:check": "eslint . --cache --ext .ts,.tsx",
    "install:extension": "jlpm build",
    "lint": "jlpm stylelint && jlpm prettier && jlpm eslint",
    "lint:check": "jlpm stylelint:check && jlpm prettier:check && jlpm eslint:check",
    "prettier": "jlpm prettier:base --write --list-different",
    "prettier:base": "prettier \"**/*{.ts,.tsx,.js,.jsx,.css,.json,.md}\"",
    "prettier:check": "jlpm prettier:base --check",
    "stylelint": "jlpm stylelint:check --fix",
    "stylelint:check": "stylelint --cache \"style/**/*.css\"",
    "test": "jest --coverage",
    "watch": "run-p watch:src watch:labextension",
    "watch:src": "tsc -w",
    "watch:labextension": "jupyter labextension watch ."
  },
  "dependencies": {
    "@jupyterlab/application": "^4.1.0",
    "@jupyterlab/apputils": "^4.1.0",
    "@jupyterlab/docmanager": "^4.1.0",
    "@jupyterlab/filebrowser": "^4.1.0",
    "@jupyterlab/notebook": "^4.1.0",
    "@jupyterlab/outputarea": "^4.1.0",
    "@jupyterlab/rendermime": "^4.1.0",
    "@jupyterlab/services": "^7.1.0",
    "@lumino/coreutils": "^2.1.0",
    "@lumino/widgets": "^2.3.0",
    "nouislider": "^15.8.1",
    "plotly.js-dist": "^3.4.0"
  },
  "resolutions": {
    "@lumino/coreutils": "^2.1.0",
    "@lumino/widgets": "^2.3.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.1.0",
    "@playwright/test": "^1.58.2",
    "@types/nouislider": "^9.0.10",
    "@types/plotly.js": "^3.0.10",
    "rimraf": "^3.0.2",
    "typescript": "~5.0.2"
  },
  "sideEffects": [
    "style/*.css",
    "style/index.js"
  ],
  "styleModule": "style/index.js",
  "publishConfig": {
    "access": "public"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "jupyphant/labextension",
    "sharedPackages": {
      "@jupyterlab/application": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/apputils": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/docmanager": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/filebrowser": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/notebook": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/outputarea": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/rendermime": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/services": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=7.0.0 <8.0.0"
      },
      "@lumino/widgets": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=2.0.0 <3.0.0"
      },
      "@jupyterlab/coreutils": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=6.0.0 <7.0.0"
      },
      "@jupyterlab/ui-components": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/mainmenu": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/console": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/logconsole": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/statusbar": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/settingregistry": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/translation": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/launcher": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/fileeditor": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      }
    }
  }
}

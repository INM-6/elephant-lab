{
  "name": "elephant-lab",
  "version": "0.1.0",
  "description": "A JupyterLab extension for interactive exploration, analysis and visualization of electrophysiological data.",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension"
  ],
  "homepage": "https://github.com/INM-6/elephant-lab",
  "bugs": {
    "url": "https://github.com/INM-6/elephant-lab/issues"
  },
  "license": "BSD-3-Clause",
  "contributors": [
    {
      "name": "Tobias Michels"
    },
    {
      "name": "Jan Nolten"
    },
    {
      "name": "Maximilian Kramer"
    },
    {
      "name": "Björn Müller"
    },
    {
      "name": "Michael Denker"
    }
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "repository": {
    "type": "git",
    "url": "https://github.com/INM-6/elephant-lab.git"
  },
  "scripts": {
    "build": "jlpm build:lib && jlpm build:labextension:dev",
    "build:prod": "jlpm clean && jlpm build:lib && jlpm build:labextension",
    "build:labextension": "jupyter labextension build .",
    "build:labextension:dev": "jupyter labextension build --development True .",
    "build:lib": "tsc",
    "clean": "jlpm clean:lib",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "clean:labextension": "rimraf elephant_lab/labextension",
    "clean:all": "jlpm clean:lib && jlpm clean:labextension",
    "install:extension": "jlpm build",
    "watch": "run-p watch:src watch:labextension",
    "watch:src": "tsc -w",
    "watch:labextension": "jupyter labextension watch ."
  },
  "dependencies": {
    "@jupyter-widgets/base": "^6.0.11",
    "@jupyter-widgets/controls": "^5.0.12",
    "@jupyter-widgets/jupyterlab-manager": "^5.0.15",
    "@jupyterlab/application": "^4.1.0",
    "@jupyterlab/apputils": "^4.1.0",
    "@jupyterlab/docmanager": "^4.1.0",
    "@jupyterlab/docregistry": "^4.1.0",
    "@jupyterlab/filebrowser": "^4.1.0",
    "@jupyterlab/notebook": "^4.1.0",
    "@jupyterlab/outputarea": "^4.1.0",
    "@jupyterlab/rendermime": "^4.1.0",
    "@jupyterlab/services": "^7.1.0",
    "@jupyterlab/ui-components": "^4.1.0",
    "@lumino/coreutils": "^2.1.0",
    "@lumino/disposable": "^2.1.0",
    "@lumino/messaging": "^2.0.0",
    "@lumino/widgets": "^2.3.0",
    "nouislider": "^15.8.1",
    "plotly.js-dist": "^3.4.0"
  },
  "resolutions": {
    "@jupyter/ydoc": "^3.0.0-a3",
    "@jupyterlab/application": "~4.5.7",
    "@jupyterlab/apputils": "~4.6.7",
    "@jupyterlab/docmanager": "~4.5.7",
    "@jupyterlab/docregistry": "~4.5.7",
    "@jupyterlab/filebrowser": "~4.5.7",
    "@jupyterlab/notebook": "~4.5.7",
    "@jupyterlab/outputarea": "~4.5.7",
    "@jupyterlab/rendermime": "~4.5.7",
    "@jupyterlab/services": "~7.5.7",
    "@jupyterlab/settingregistry": "~4.5.7",
    "@jupyterlab/ui-components": "~4.5.7",
    "@lumino/coreutils": "^2.1.0",
    "@lumino/widgets": "^2.3.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.1.0",
    "@playwright/test": "^1.58.2",
    "@types/nouislider": "^9.0.10",
    "@types/plotly.js": "^3.0.10",
    "rimraf": "^3.0.2",
    "typescript": "~5.0.2"
  },
  "sideEffects": [
    "style/*.css",
    "style/index.js"
  ],
  "styleModule": "style/index.js",
  "publishConfig": {
    "access": "public"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "elephant_lab/labextension",
    "schemaDir": "schema",
    "sharedPackages": {
      "@jupyterlab/application": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/apputils": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/docmanager": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/filebrowser": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/notebook": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/outputarea": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/rendermime": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/services": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=7.0.0 <8.0.0"
      },
      "@lumino/widgets": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=2.0.0 <3.0.0"
      },
      "@jupyterlab/coreutils": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=6.0.0 <7.0.0"
      },
      "@jupyterlab/ui-components": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/mainmenu": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/console": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/logconsole": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/statusbar": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/settingregistry": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/translation": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/launcher": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      },
      "@jupyterlab/fileeditor": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": ">=4.0.0 <5.0.0"
      }
    }
  }
}
